# ==============================================================================
# LLM Chart Generator — Environment Configuration Template
# Copy this file to .env in the repository root for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Configuration
# ------------------------------------------------------------------------------
# Provider choice: 'openai' (default), 'ollama', or 'fallback' (local parser)
LLM_PROVIDER=openai

# OpenAI API Key (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Custom OpenAI-compatible endpoint (optional, defaults to https://api.openai.com/v1/chat/completions)
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Optional per-million-token rates for estimated OpenAI request cost metrics.
# Configure these to match the selected model/provider pricing; no default is assumed.
# OPENAI_INPUT_USD_PER_1M_TOKENS=...
# OPENAI_OUTPUT_USD_PER_1M_TOKENS=...

# Local Ollama settings (required when LLM_PROVIDER=ollama)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:8b

# LLM request timeout in milliseconds (default: 60000)
# LLM_TIMEOUT_MS=60000

# ------------------------------------------------------------------------------
# 2. Database & Persistence Configuration (Backend)
# ------------------------------------------------------------------------------
# Canonical connection URL for Neon Postgres (Lakebase Postgres)
# If unset, backend operates in in-memory fallback mode for diagram sharing.
# DATABASE_URL is also accepted as a backwards-compatible alias.
POSTGRES_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. Server, Security & Rate Limiting (Backend)
# ------------------------------------------------------------------------------
# Backend HTTP port (default: 4173 in dev, 4000 in Docker)
PORT=4173

# Frontend origin allowed for CORS requests (e.g. your Vercel deployment URL)
ALLOWED_ORIGIN=http://localhost:5173

# Abuse deterrent API key (optional)
# Must match VITE_APP_API_KEY in the frontend if configured.
# Note: VITE_APP_API_KEY is bundled into client JS and serves as an abuse deterrent,
# not a private server secret.
# APP_API_KEY=your_shared_api_deterrent_key_here

# Real server-side secret for private API access (optional)
# Sent via standard 'Authorization: Bearer <SERVER_API_KEY>' header.
# Never expose this to frontend bundles or client-side code.
# SERVER_API_KEY=your_private_server_secret_here

# Enforce strict private authorization (optional, default: false)
# When set to true, disables public frontend keys and strictly requires
# valid Bearer authorization on all protected endpoints.
# REQUIRE_PRIVATE_AUTH=false

# Shared rate limiting store via Upstash Redis (optional)
# If unset, in-memory rate limiting is used per instance.
# UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Rate limiting thresholds (per IP address)
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=60000
# Daily request quota per IP (default: 200 requests / 24 hours)
# DAILY_RATE_LIMIT_MAX=200
# Global daily quota across all callers (default: 1000 requests / 24 hours; shared across instances with Upstash)
# GLOBAL_DAILY_RATE_LIMIT_MAX=1000

# Additional limits for verified Bearer callers, applied per verified identity and caller IP.
# Defaults match the public per-IP thresholds; set separately if server clients need different quotas.
# AUTH_RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_WINDOW_MS=60000
# AUTH_DAILY_RATE_LIMIT_MAX=200

# Periodic background cleanup job (optional)
# Automatically deletes shared diagrams older than CLEANUP_RETENTION_DAYS.
# Set CLEANUP_ENABLED=false to disable. Runs npm run db:cleanup for manual runs.
# CLEANUP_ENABLED=true
# CLEANUP_INTERVAL_HOURS=24
# CLEANUP_RETENTION_DAYS=90

# ------------------------------------------------------------------------------
# 4. Observability & Telemetry (Backend)
# ------------------------------------------------------------------------------
# Sentry DSN for error reporting (optional)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# NODE_ENV=development

# ------------------------------------------------------------------------------
# 5. Frontend Variables (Build-time only)
# ------------------------------------------------------------------------------
# NOTICE: VITE_* variables are baked into static client bundles at build time.
# Never place database passwords, private OpenAI keys, or server secrets here.
#
# Backend API base URL for the browser to call
VITE_API_BASE=http://localhost:4173

# Frontend abuse-deterrent key (must match APP_API_KEY if enabled on backend)
# VITE_APP_API_KEY=your_shared_api_deterrent_key_here
