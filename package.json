{
  "name": "llm-chart-generator",
  "private": true,
  "version": "1.0.1",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel server:dev client:dev",
    "build": "npm run server:build && npm run client:build",
    "db:cleanup": "cd server && npm run db:cleanup",
    "db:migrate": "cd server && npm run db:migrate",
    "test": "npm run server:test && npm run client:test",
    "test:smoke": "node scripts/smoke-test.mjs",
    "capacity:check": "npm run server:build && node scripts/capacity-check.mjs",
    "server:dev": "cd server && npm run dev",
    "server:build": "cd server && npm run build",
    "server:test": "cd server && npm test",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "client:budget": "node scripts/check-client-bundle.mjs",
    "client:lint": "cd client && npm run lint",
    "client:test": "cd client && npm test",
    "release:check": "node scripts/check-release-version.mjs"
  },
  "devDependencies": {
    "@neon/config": "^1.7.2",
    "npm-run-all": "^4.1.5"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "nodemon": {
      "minimatch": "^11.0.1"
    }
  },
  "dependencies": {
    "@types/react-dom": "^19.2.5",
    "axios": "^1.20.0",
    "eslint-plugin-react-refresh": "^0.5.5",
    "mermaid": "^12.3.0",
    "typescript-eslint": "^8.68.0"
  }
}
